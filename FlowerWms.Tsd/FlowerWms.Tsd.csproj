<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>FlowerWms.Tsd</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Настройки Android -->
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidKeyStore>false</AndroidKeyStore>
        <ApplicationId>com.alphaflowers.wms</ApplicationId>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        
        <!-- Версия сборки (обновлять при релизе) -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <AssemblyFileVersion>1.0.0.0</AssemblyFileVersion>
        <InformationalVersion>1.0.0.0</InformationalVersion>
        
        <!-- Пути к Android SDK и Java SDK -->
        <AndroidSdkDirectory>F:\program\AndroidSDK</AndroidSdkDirectory>
        <JavaSdkDirectory>C:\Program Files\Java\jdk-17</JavaSdkDirectory>
    </PropertyGroup>

    <!-- Настройки для Release-сборки -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RunAOTCompilation>false</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>
        <AndroidLinkTool>r8</AndroidLinkTool>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        
        <!-- SQLite -->
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
        <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.11" />
        
        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>

    <ItemGroup>
        <MauiAsset Include="Resources\Raw\config.json" LogicalName="config.json" />
    </ItemGroup>

</Project>
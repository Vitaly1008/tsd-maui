<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                xmlns:converters="clr-namespace:FlowerWms.Tsd.Converters"
                x:Class="FlowerWms.Tsd.Views.SyncQueuePage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:SyncQueueViewModel"
                Title="Очередь синхронизации">

    <!-- Регистрируем конвертеры как статические ресурсы -->
    <views:BasePage.Resources>
        <ResourceDictionary>
            <converters:OperationIconConverter x:Key="OperationIconConverter" />
            <converters:OperationTypeDisplayConverter x:Key="OperationTypeDisplayConverter" />
            <converters:StatusDisplayConverter x:Key="StatusDisplayConverter" />
            <converters:StatusColorConverter x:Key="StatusColorConverter" />
            <converters:RetryCountDisplayConverter x:Key="RetryCountDisplayConverter" />
            <converters:CreatedAtDisplayConverter x:Key="CreatedAtDisplayConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:IsZeroConverter x:Key="IsZeroConverter" />
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        </ResourceDictionary>
    </views:BasePage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Верхняя панель -->
        <Grid Grid.Row="0" 
              Padding="16,12" 
              BackgroundColor="{StaticResource PrimaryColor}"
              ColumnDefinitions="Auto, *">
            
            <Button Grid.Column="0"
                    Text="‹ Назад"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="16"
                    Padding="0"
                    HorizontalOptions="Start" />

            <Label Grid.Column="1" 
                   Text="📋 Очередь синхронизации" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Статистика -->
        <Grid Grid.Row="1" 
              Padding="12,8" 
              BackgroundColor="#F5F5F5"
              ColumnDefinitions="*, *, *">
            
            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Label Text="Всего" FontSize="11" TextColor="Gray" />
                <Label Text="{Binding TotalCount}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="📥 Приемка" FontSize="11" TextColor="Gray" />
                <Label Text="{Binding ReceivingCount}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}" />
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Label Text="📤 Отгрузка" FontSize="11" TextColor="Gray" />
                <Label Text="{Binding ShippingCount}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource WarningColor}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Список транзакций -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="12">
                    
                    <!-- Статус и кнопки управления -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" 
                               Text="{Binding StatusMessage}" 
                               FontSize="14" 
                               TextColor="Gray"
                               VerticalOptions="Center" />
                        
                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                            <Button Text="🔄 Синхр."
                                    Command="{Binding SyncAllCommand}"
                                    IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertBooleanConverter}}"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    TextColor="White"
                                    CornerRadius="6"
                                    HeightRequest="32"
                                    FontSize="11"
                                    Padding="8,0" />
                            
                            <Button Text="🗑️ Очистить"
                                    Command="{Binding ClearAllCommand}"
                                    IsEnabled="{Binding PendingTransactions.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                    BackgroundColor="{StaticResource DangerColor}"
                                    TextColor="White"
                                    CornerRadius="6"
                                    HeightRequest="32"
                                    FontSize="11"
                                    Padding="8,0" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Индикатор синхронизации -->
                    <Grid IsVisible="{Binding IsSyncing}" Padding="8">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource PrimaryColor}" HeightRequest="20" />
                            <Label Text="Выполняется синхронизация..." FontSize="14" TextColor="{StaticResource PrimaryColor}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Список транзакций -->
                    <CollectionView ItemsSource="{Binding PendingTransactions}"
                                    IsVisible="{Binding PendingTransactions.Count, Converter={StaticResource GreaterThanZeroConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12"
                                       CornerRadius="8"
                                       HasShadow="True"
                                       BackgroundColor="White"
                                       Margin="0,4">
                                    
                                    <Grid RowDefinitions="Auto, Auto, Auto"
                                          ColumnDefinitions="Auto, *, Auto">
                                        
                                        <!-- Иконка операции -->
                                        <Label Grid.Row="0" Grid.Column="0" 
                                               Text="{Binding operation_type, Converter={StaticResource OperationIconConverter}}"
                                               FontSize="24"
                                               VerticalOptions="Center"
                                               Margin="0,0,12,0" />
                                        
                                        <!-- Информация об операции -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding operation_type, Converter={StaticResource OperationTypeDisplayConverter}}"
                                                   FontSize="15" FontAttributes="Bold" />
                                            <Label Text="{Binding barcode, StringFormat='ШК: {0}'}" FontSize="12" TextColor="Gray" />
                                        </VerticalStackLayout>
                                        
                                        <!-- Кнопки действий -->
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="4">
                                            <Button Text="🔄"
                                                    Command="{Binding BindingContext.SyncSingleTransactionCommand, Source={RelativeSource AncestorType={x:Type views:SyncQueuePage}}}"
                                                    CommandParameter="{Binding transaction_id}"
                                                    BackgroundColor="{StaticResource SuccessColor}"
                                                    TextColor="White"
                                                    CornerRadius="4"
                                                    HeightRequest="28"
                                                    WidthRequest="36"
                                                    FontSize="12"
                                                    Padding="0" />
                                            <Button Text="✕"
                                                    Command="{Binding BindingContext.DeleteTransactionCommand, Source={RelativeSource AncestorType={x:Type views:SyncQueuePage}}}"
                                                    CommandParameter="{Binding transaction_id}"
                                                    BackgroundColor="{StaticResource DangerColor}"
                                                    TextColor="White"
                                                    CornerRadius="4"
                                                    HeightRequest="28"
                                                    WidthRequest="36"
                                                    FontSize="12"
                                                    Padding="0" />
                                        </HorizontalStackLayout>
                                        
                                        <!-- Детали операции -->
                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                              Margin="0,4,0,0"
                                              ColumnDefinitions="Auto, *, Auto">
                                            
                                            <Label Grid.Column="0" 
                                                   Text="{Binding Converter={StaticResource StatusDisplayConverter}}"
                                                   FontSize="11"
                                                   TextColor="{Binding Converter={StaticResource StatusColorConverter}}" />
                                            
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Converter={StaticResource RetryCountDisplayConverter}}"
                                                   FontSize="11"
                                                   TextColor="Gray"
                                                   HorizontalOptions="Center" />
                                            
                                            <Label Grid.Column="2" 
                                                   Text="{Binding Converter={StaticResource CreatedAtDisplayConverter}}"
                                                   FontSize="11"
                                                   TextColor="Gray" />
                                        </Grid>

                                        <!-- Сообщение об ошибке -->
                                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                               Text="{Binding error_message}"
                                               IsVisible="{Binding error_message, Converter={StaticResource StringNotEmptyConverter}}"
                                               FontSize="12"
                                               TextColor="Red"
                                               Margin="0,4,0,0" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Пустое состояние -->
                    <VerticalStackLayout IsVisible="{Binding PendingTransactions.Count, Converter={StaticResource IsZeroConverter}}"
                                         Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="0,40">
                        <Label Text="✅" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Нет операций для синхронизации" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="Все данные синхронизированы" FontSize="13" TextColor="Gray" Opacity="0.6" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</views:BasePage>
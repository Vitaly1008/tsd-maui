<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                x:Class="FlowerWms.Tsd.Views.InventoryPage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:InventoryViewModel"
                Title="">
    
    <Grid RowDefinitions="Auto, *">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" 
              Padding="16,12" 
              BackgroundColor="{StaticResource PrimaryColor}"
              ColumnDefinitions="Auto, *, Auto">
            
            <Label Grid.Column="0" 
                   Text="📊" 
                   FontSize="22"
                   TextColor="White"
                   VerticalOptions="Center" />

            <Label Grid.Column="1" 
                   Text="Инвентаризация" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="12,0,0,0" />

            <Label Grid.Column="2" 
                   Text="{Binding IsOnline, Converter={StaticResource ConnectionIconConverter}}" 
                   FontSize="18"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Основной контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Режим -->
                <Label Text="{Binding ModeText}" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource PrimaryColor}" />

                <!-- Статус сканирования -->
                <Frame Padding="16" 
                       CornerRadius="12" 
                       BackgroundColor="{Binding ScanStatusColor, Converter={StaticResource ScanStatusBackgroundConverter}}"
                       BorderColor="{Binding ScanStatusColor}">
                    <Grid ColumnDefinitions="36, *">
                        <Label Grid.Column="0" 
                               Text="{Binding ScanStatusIcon}" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="8,0,0,0" Spacing="4">
                            <Label Text="{Binding ScanStatusText}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{Binding ScanStatusColor}" />
                            <Label Text="{Binding ErrorMessage}" 
                                   FontSize="14" 
                                   TextColor="Red"
                                   IsVisible="{Binding HasError}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- ============================================================ -->
                <!-- РЕЖИМ 1: ПРОСМОТР ЛОКАЦИИ -->
                <!-- ============================================================ -->
                <VerticalStackLayout IsVisible="{Binding IsLocationMode}">
                    <!-- Информация о локации -->
                    <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                        <Label Text="{Binding LocationInfo}" 
                               FontSize="15" 
                               LineBreakMode="WordWrap" />
                    </Frame>

                    <!-- Счетчики -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Frame Padding="12" CornerRadius="10" BackgroundColor="#E8F5E9">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="📦 Коробок" TextColor="Gray" FontSize="12" />
                                <Label Text="{Binding TotalBoxesInLocation}" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource PrimaryColor}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Padding="12" CornerRadius="10" BackgroundColor="#E3F2FD">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="📊 Количество" TextColor="Gray" FontSize="12" />
                                <Label Text="{Binding TotalQuantityInLocation}" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       TextColor="#1565C0"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                   <!-- Список коробок -->
                    <Frame Padding="0" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <Frame Grid.Row="0" 
                                Padding="16,12" 
                                BackgroundColor="{StaticResource PrimaryColor}"
                                CornerRadius="12,12,0,0"
                                HasShadow="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" 
                                        Text="📦 Коробки на локации" 
                                        TextColor="White" 
                                        FontSize="16" 
                                        FontAttributes="Bold" />
                                    <Label Grid.Column="1" 
                                        Text="{Binding TotalBoxesInLocation, StringFormat='{0} шт.'}" 
                                        TextColor="White" 
                                        FontSize="14" />
                                </Grid>
                            </Frame>

                            <!-- ✅ Убираем Padding у CollectionView, используем Margin у ItemTemplate -->
                            <CollectionView Grid.Row="1"
                                            ItemsSource="{Binding LocationBoxes}"
                                            HeightRequest="250">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,4" Margin="8,0" ColumnDefinitions="Auto, *">
                                            <Label Grid.Column="0" 
                                                Text="📦" 
                                                FontSize="16"
                                                VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Padding="8,0">
                                                <Label Text="{Binding BoxNumber, StringFormat='Коробка #{0}'}" 
                                                    FontSize="14" 
                                                    FontAttributes="Bold" />
                                                <Label Text="{Binding ProductName}" 
                                                    FontSize="12" 
                                                    TextColor="Gray" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding CurrentQuantity, StringFormat='{0} шт.'}" 
                                                        FontSize="11" 
                                                        TextColor="Gray" />
                                                    <Label Text="{Binding Grade}" 
                                                        FontSize="11" 
                                                        TextColor="Gray" />
                                                    <Label Text="{Binding Barcode}" 
                                                        FontSize="10" 
                                                        TextColor="Gray"
                                                        FontAttributes="Italic" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>

                    <!-- Кнопки -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Grid.Column="0" 
                                Text="🔄 Обновить" 
                                Command="{Binding RefreshLocationCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" 
                                Text="📷 Сканировать" 
                                Command="{Binding ScanBarcodeCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- ============================================================ -->
                <!-- РЕЖИМ 2: ПЕРЕМЕЩЕНИЕ КОРОБКИ -->
                <!-- ============================================================ -->
                <VerticalStackLayout IsVisible="{Binding IsMoveMode}">
                    
                    <!-- Информация о выбранной коробке -->
                    <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                        <Label Text="{Binding SelectedBoxInfo}" 
                               FontSize="15" 
                               LineBreakMode="WordWrap" />
                    </Frame>

                    <!-- Текущая и целевая локация -->
                    <Frame Padding="16" CornerRadius="12" BackgroundColor="#FFF3E0">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="📍 Новая локация" TextColor="Gray" FontSize="12" />
                                <Label Text="{Binding TargetLocation, FallbackValue='Не указана'}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{Binding TargetLocation, Converter={StaticResource IsNotNullConverter}, FallbackValue='Gray'}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="✏️"
                                    Command="{Binding SetTargetLocationCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource PrimaryColor}"
                                    FontSize="20"
                                    Padding="8,0" />
                        </Grid>
                    </Frame>

                    <!-- Кнопки -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Grid.Column="0" 
                                Text="↩️ Отмена" 
                                Command="{Binding CancelMoveCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" 
                                Text="✅ Переместить" 
                                Command="{Binding MoveBoxCommand}"
                                IsEnabled="{Binding TargetLocation, Converter={StaticResource IsNotNullConverter}}"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>

                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   Color="{StaticResource PrimaryColor}" 
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
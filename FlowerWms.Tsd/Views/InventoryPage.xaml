<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                x:Class="FlowerWms.Tsd.Views.InventoryPage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:InventoryViewModel"
                Title="">
    
    <Grid RowDefinitions="Auto, *">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" 
              Padding="12" 
              BackgroundColor="{StaticResource PrimaryColor}"
              ColumnDefinitions="Auto, *, Auto">
            
            <!-- ✅ Кнопка "Назад" работает -->
            <Frame Grid.Column="0"
                   BackgroundColor="Transparent"
                   Padding="4"
                   CornerRadius="8"
                   WidthRequest="44"
                   HeightRequest="44"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Frame.GestureRecognizers>
                <Label Text="‹" 
                       FontSize="32" 
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>

            <Label Grid.Column="1" 
                   Text="📊 Инвентаризация" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="8,0,0,0" />

            <!-- ✅ Индикатор подключения -->
            <Label Grid.Column="2" 
                   Text="{Binding IsOnline, Converter={StaticResource ConnectionIconConverter}}" 
                   FontSize="20"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Основной контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="12">

                <!-- Переключатель режимов -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Button Grid.Column="0" 
                            Text="📦 Информация о коробке" 
                            Command="{Binding SwitchModeCommand}"
                            BackgroundColor="{Binding IsBoxMode, Converter={StaticResource ModeBackgroundConverter}}"
                            TextColor="{Binding IsBoxMode, Converter={StaticResource ModeTextColorConverter}}"
                            FontSize="14"
                            FontAttributes="Bold" />
                    <Button Grid.Column="1" 
                            Text="📍 Сканирование локации" 
                            Command="{Binding SwitchModeCommand}"
                            BackgroundColor="{Binding IsLocationMode, Converter={StaticResource ModeBackgroundConverter}}"
                            TextColor="{Binding IsLocationMode, Converter={StaticResource ModeTextColorConverter}}"
                            FontSize="14"
                            FontAttributes="Bold" />
                </Grid>

                <!-- Текущий режим -->
                <Label Text="{Binding ScanModeText}" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource PrimaryColor}" />

                <!-- Информационное поле сканирования -->
                <Frame Padding="16" 
                       CornerRadius="12" 
                       BackgroundColor="{Binding LastScannedBarcode, Converter={StaticResource ScanStatusBackgroundConverter}}"
                       BorderColor="{Binding LastScannedBarcode, Converter={StaticResource ScanStatusBorderConverter}}">
                    <Grid ColumnDefinitions="36, *">
                        <Label Grid.Column="0" 
                               Text="{Binding LastScannedBarcode, Converter={StaticResource ScanStatusIconConverter}}" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="8,0,0,0" Spacing="4">
                            <Label Text="{Binding LastScannedBarcode, Converter={StaticResource ScanStatusTextConverter}}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{Binding LastScannedBarcode, Converter={StaticResource ScanStatusColorConverter}}" />
                            <Label Text="📷 Нажмите триггер для сканирования" 
                                   FontSize="12" 
                                   TextColor="#9E9E9E" 
                                   IsVisible="{Binding LastScannedBarcode, Converter={StaticResource IsNotNullConverter}, ConverterParameter=invert}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- РЕЖИМ 1: Информация о коробке -->
                <VerticalStackLayout IsVisible="{Binding IsBoxMode}">
                    <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                        <Label Text="{Binding CurrentBoxInfo}" 
                               FontSize="14" 
                               LineBreakMode="WordWrap" />
                    </Frame>

                    <!-- Поле для ввода новой локации -->
                    <Entry Placeholder="Новая локация для перемещения" 
                           Text="{Binding TargetLocation}"
                           IsVisible="{Binding CurrentBox, Converter={StaticResource IsNotNullConverter}}" />

                    <Button Text="🔄 Переместить коробку" 
                            Command="{Binding MoveBoxCommand}"
                            IsEnabled="{Binding IsActionEnabled}"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>

                <!-- РЕЖИМ 2: Сканирование локации -->
                <VerticalStackLayout IsVisible="{Binding IsLocationMode}">
                    <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                        <Label Text="{Binding CurrentLocationInfo}" 
                               FontSize="14" 
                               LineBreakMode="WordWrap" />
                    </Frame>

                    <!-- Прогресс -->
                    <Frame Padding="12" CornerRadius="8" BackgroundColor="{StaticResource PrimaryColor}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   Text="📊 Прогресс инвентаризации" 
                                   TextColor="White" 
                                   FontSize="14" 
                                   FontAttributes="Bold" />
                            <Label Grid.Column="1" 
                                   Text="{Binding ProgressText}" 
                                   TextColor="White" 
                                   FontSize="14" 
                                   FontAttributes="Bold" />
                        </Grid>
                    </Frame>

                    <!-- Список неотсканированных коробок -->
                    <VerticalStackLayout IsVisible="{Binding NotScannedBoxes.Count, Converter={StaticResource GreaterThanZeroConverter}}">
                        <Label Text="📦 Не отсканированы:" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="Gray" />
                        <CollectionView ItemsSource="{Binding NotScannedBoxes}" 
                                        HeightRequest="150">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding BoxNumber, StringFormat='Коробка #{0}'}" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding ProductName}" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" 
                                               Text="⏳" 
                                               FontSize="16" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Список отсканированных коробок -->
                    <VerticalStackLayout IsVisible="{Binding ScannedBoxes.Count, Converter={StaticResource GreaterThanZeroConverter}}">
                        <Label Text="✅ Отсканированы:" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="Green" />
                        <CollectionView ItemsSource="{Binding ScannedBoxes}" 
                                        HeightRequest="150">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding BoxNumber, StringFormat='Коробка #{0}'}" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding ProductName}" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" 
                                               Text="✅" 
                                               FontSize="16" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Button Text="✅ Завершить инвентаризацию" 
                            Command="{Binding CompleteLocationInventoryCommand}"
                            IsEnabled="{Binding TotalCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>

                <!-- Индикатор загрузки -->
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   Color="{StaticResource PrimaryColor}" 
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
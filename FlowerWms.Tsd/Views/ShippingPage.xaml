<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                x:Class="FlowerWms.Tsd.Views.ShippingPage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:ShippingViewModel"
                Title="">
    
    <Grid RowDefinitions="Auto, *">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" 
              Padding="16,12" 
              BackgroundColor="{StaticResource PrimaryColor}"
              ColumnDefinitions="Auto, *, Auto">
            
            <Label Grid.Column="0" 
                   Text="📤" 
                   FontSize="22"
                   TextColor="White"
                   VerticalOptions="Center" />

            <Label Grid.Column="1" 
                   Text="Отгрузка" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="12,0,0,0" />

            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <Label Text="{Binding ScannedCount, StringFormat='📦 {0}'}" 
                       TextColor="White" 
                       FontSize="14"
                       FontAttributes="Bold" />
                <Label Text="{Binding IsOnline, Converter={StaticResource ConnectionIconConverter}}" 
                       FontSize="18" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Основной контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Кнопка "Отгрузить" - наверху -->
                <Button Text="✅ Отгрузить коробки" 
                        Command="{Binding ConfirmOperationCommand}"
                        IsEnabled="{Binding ScannedBoxes.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Статус сканирования -->
                <Frame Padding="16" 
                       CornerRadius="12" 
                       BackgroundColor="{Binding ScanStatusColor, Converter={StaticResource ScanStatusBackgroundConverter}}"
                       BorderColor="{Binding ScanStatusColor}">
                    <Grid ColumnDefinitions="36, *">
                        <Label Grid.Column="0" 
                               Text="{Binding ScanStatusIcon}" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="8,0,0,0" Spacing="4">
                            <Label Text="{Binding ScanStatusText}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{Binding ScanStatusColor}" />
                            <Label Text="{Binding BoxInfoText}" 
                                   FontSize="14" 
                                   TextColor="Gray"
                                   IsVisible="{Binding IsBoxScanned}" />
                            <Label Text="{Binding ErrorMessage}" 
                                   FontSize="14" 
                                   TextColor="Red"
                                   IsVisible="{Binding HasError}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Кнопка выбора заказа (заглушка) -->
                <Button Text="{Binding OrderButtonText}"
                        Command="{Binding SelectOrderCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Opacity="0.7" />

                <!-- Локация (как в приемке) -->
                <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📍 Локация отгрузки" TextColor="Gray" FontSize="12" />
                            <Label Text="{Binding ScannedBoxes.Count, Converter={StaticResource LocationDisplayConverter}, FallbackValue='Не указана'}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource PrimaryColor}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="✏️"
                                Command="{Binding ShowLocationInputCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource PrimaryColor}"
                                FontSize="20"
                                Padding="8,0" />
                    </Grid>
                </Frame>

                <!-- Список отсканированных коробок - выпадающий (как в приемке) -->
                <Frame Padding="0" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- Заголовок с возможностью сворачивания -->
                        <Frame Grid.Row="0" 
                               Padding="16,12" 
                               BackgroundColor="{StaticResource PrimaryColor}"
                               CornerRadius="12,12,0,0"
                               HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer>
                                    <TapGestureRecognizer.Command>
                                        <Binding Path="ToggleBoxListCommand" />
                                    </TapGestureRecognizer.Command>
                                </TapGestureRecognizer>
                            </Frame.GestureRecognizers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" 
                                       Text="📦 Коробки к отгрузке" 
                                       TextColor="White" 
                                       FontSize="16" 
                                       FontAttributes="Bold" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="{Binding ScannedCount, StringFormat='{0} шт.'}" 
                                           TextColor="White" 
                                           FontSize="14" />
                                    <Label Text="{Binding IsBoxListExpanded, Converter={StaticResource ExpandIconConverter}}" 
                                           TextColor="White" 
                                           FontSize="16" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>

                        <!-- Список - отображается только если развернут -->
                        <CollectionView Grid.Row="1"
                                        IsVisible="{Binding IsBoxListExpanded}"
                                        ItemsSource="{Binding ScannedBoxes}"
                                        HeightRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4" Margin="8,0" ColumnDefinitions="Auto, *, Auto">
                                        <Label Grid.Column="0" 
                                               Text="{Binding Status, Converter={StaticResource BoxStatusIconConverter}, FallbackValue='📦'}" 
                                               FontSize="16"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Padding="8,0">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding BoxNumber, StringFormat='Коробка #{0}'}" 
                                                       FontSize="14" 
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Status, Converter={StaticResource BoxStatusLabelConverter}}" 
                                                       FontSize="10" 
                                                       TextColor="White"
                                                       BackgroundColor="{Binding Status, Converter={StaticResource BoxStatusColorConverter}}"
                                                       Padding="6,2"
                                                       HorizontalOptions="Start" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding ProductName}" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            <Label Text="{Binding CurrentQuantity, StringFormat='{0} шт. | {1}'}" 
                                                   FontSize="11" 
                                                   TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                            <!-- Кнопка истории -->
                                            <Button Text="📋"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type views:ShippingPage}}, Path=BindingContext.ShowBoxHistoryCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="Blue"
                                                    FontSize="14"
                                                    Padding="4,0" />
                                            <!-- Кнопка удаления -->
                                            <Button Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type views:ShippingPage}}, Path=BindingContext.RemoveBoxCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="Red"
                                                    FontSize="18"
                                                    Padding="4,0" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Frame>

                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   Color="{StaticResource PrimaryColor}" 
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                xmlns:behaviors="clr-namespace:FlowerWms.Tsd.Views.Behaviors"
                xmlns:converters="clr-namespace:FlowerWms.Tsd.Converters"
                x:Class="FlowerWms.Tsd.Views.ShippingPage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:ShippingViewModel"
                Title="Отгрузка">

    <Grid RowDefinitions="Auto, *">

        <!-- ============================================================ -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ (как в ReceivingPage) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" 
              Padding="16,12" 
              BackgroundColor="{StaticResource PrimaryColor}"
              ColumnDefinitions="Auto, *, Auto">
            
            <Label Grid.Column="0" 
                   Text="📤" 
                   FontSize="22"
                   TextColor="White"
                   VerticalOptions="Center" />

            <Label Grid.Column="1" 
                   Text="Отгрузка" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="12,0,0,0" />

            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <Label Text="{Binding ScannedCount, StringFormat='📦 {0}'}" 
                       TextColor="White" 
                       FontSize="14"
                       FontAttributes="Bold" />
                <Label Text="{Binding IsOnline, Converter={StaticResource ConnectionIconConverter}}" 
                       FontSize="18" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ============================================================ -->
        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <!-- ============================================================ -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- ============================================================ -->
                <!-- КНОПКА "ОТГРУЗИТЬ" - НАВЕРХУ (как в ReceivingPage) -->
                <!-- ============================================================ -->
                <Button Text="✅ Отгрузить коробки" 
                        Command="{Binding ConfirmOperationCommand}"
                        IsEnabled="{Binding ScannedBoxes.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- ============================================================ -->
                <!-- СТАТУС СКАНИРОВАНИЯ -->
                <!-- ============================================================ -->
                <Frame Padding="16" 
                       CornerRadius="12" 
                       BackgroundColor="{Binding ScanStatusColor, Converter={StaticResource ScanStatusBackgroundConverter}}"
                       BorderColor="{Binding ScanStatusColor}">
                    <Grid ColumnDefinitions="36, *">
                        <Label Grid.Column="0" 
                               Text="{Binding ScanStatusIcon}" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="8,0,0,0" Spacing="4">
                            <Label Text="{Binding ScanStatusText}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{Binding ScanStatusColor}" />
                            <Label Text="{Binding BoxInfoText}" 
                                   FontSize="14" 
                                   TextColor="Gray"
                                   IsVisible="{Binding IsBoxScanned}" />
                            <Label Text="{Binding ErrorMessage}" 
                                   FontSize="14" 
                                   TextColor="Red"
                                   IsVisible="{Binding HasError}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- ============================================================ -->
                <!-- ИНФОРМАЦИЯ О КОРОБКЕ (при сканировании) -->
                <!-- ============================================================ -->
                <Frame IsVisible="{Binding IsBoxScanned}" 
                       Padding="16" 
                       CornerRadius="12" 
                       HasShadow="True" 
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding BoxInfoText}" 
                               FontSize="14" 
                               TextColor="#333"/>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="№" FontAttributes="Bold" FontSize="14"/>
                            <Label Text="{Binding BoxNumberDisplay}" 
                                   FontAttributes="Bold" 
                                   FontSize="14"
                                   TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="·" TextColor="Gray"/>
                            <Label Text="Доступно:" FontSize="13" TextColor="Gray"/>
                            <Label Text="{Binding MaxQuantity, StringFormat='{0} шт.'}" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryColor}"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding AvailabilityWarning}" 
                               FontSize="12" 
                               TextColor="Orange"
                               IsVisible="{Binding HasAvailabilityWarning}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ============================================================ -->
                <!-- УПРАВЛЕНИЕ РЕЖИМАМИ ОТГРУЗКИ -->
                <!-- ============================================================ -->
                <VerticalStackLayout IsVisible="{Binding IsBoxScanned}" Spacing="8">
                    
                    <!-- Переключатель режимов -->
                    <Frame IsVisible="{Binding CanPartialShip}" 
                           Padding="4" 
                           CornerRadius="12" 
                           BackgroundColor="#EEEEEE"
                           HasShadow="False">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
                            <Button Grid.Column="0" 
                                    Text="📦 Полная"
                                    Command="{Binding SetFullShipmentCommand}"
                                    BackgroundColor="{Binding IsFullShipmentMode, Converter={StaticResource ModeBackgroundConverter}}"
                                    TextColor="{Binding IsFullShipmentMode, Converter={StaticResource ModeTextColorConverter}}"
                                    BorderColor="{Binding IsFullShipmentMode, Converter={StaticResource ModeBorderConverter}}"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="8,6"/>

                            <Button Grid.Column="1" 
                                    Text="✂️ Частичная"
                                    Command="{Binding SetPartialShipmentCommand}"
                                    BackgroundColor="{Binding IsPartialShipmentMode, Converter={StaticResource ModeBackgroundConverter}}"
                                    TextColor="{Binding IsPartialShipmentMode, Converter={StaticResource ModeTextColorConverter}}"
                                    BorderColor="{Binding IsPartialShipmentMode, Converter={StaticResource ModeBorderConverter}}"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="8,6"/>
                        </Grid>
                    </Frame>

                    <!-- Подсказка о режиме -->
                    <Label Text="{Binding ShipModeDescription}" 
                           FontSize="12" 
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           IsVisible="{Binding CanPartialShip}"/>

                    <!-- Управление количеством (для частичной отгрузки) -->
                    <Frame IsVisible="{Binding IsPartialShipmentMode}" 
                           Padding="12" 
                           CornerRadius="10" 
                           BackgroundColor="#F8F8F8"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Количество для отгрузки:" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Button Grid.Column="0" 
                                        Text="−" 
                                        Command="{Binding DecreaseQuantityCommand}"
                                        BackgroundColor="#FF5722" 
                                        TextColor="White"
                                        WidthRequest="48" 
                                        HeightRequest="48" 
                                        FontSize="20"
                                        CornerRadius="24"
                                        Padding="0"/>
                                
                                <Entry Grid.Column="1" 
                                       Text="{Binding ShipQuantityDisplay}"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}"
                                       BackgroundColor="White"
                                       Placeholder="0"
                                       PlaceholderColor="LightGray"
                                       MaxLength="6"
                                       Completed="OnQuantityEntryCompleted">
                                    <Entry.Behaviors>
                                        <behaviors:NumericValidationBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                                
                                <Button Grid.Column="2" 
                                        Text="+" 
                                        Command="{Binding IncreaseQuantityCommand}"
                                        BackgroundColor="#4CAF50" 
                                        TextColor="White"
                                        WidthRequest="48" 
                                        HeightRequest="48" 
                                        FontSize="20"
                                        CornerRadius="24"
                                        Padding="0"/>
                            </Grid>

                            <Label Text="{Binding MaxQuantity, StringFormat='Макс: {0} шт.'}" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center"/>
                            
                            <Label Text="⚠️ Количество превышает доступное!" 
                                   FontSize="12" 
                                   TextColor="Red"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding IsQuantityExceeded}"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- ============================================================ -->
                <!-- СПИСОК ОТСКАНИРОВАННЫХ КОРОБОК - ВЫПАДАЮЩИЙ (как в ReceivingPage) -->
                <!-- ============================================================ -->
                <Frame Padding="0" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- Заголовок с возможностью сворачивания -->
                        <Frame Grid.Row="0" 
                               Padding="16,12" 
                               BackgroundColor="{StaticResource PrimaryColor}"
                               CornerRadius="12,12,0,0"
                               HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer>
                                    <TapGestureRecognizer.Command>
                                        <Binding Path="ToggleBoxListCommand" />
                                    </TapGestureRecognizer.Command>
                                </TapGestureRecognizer>
                            </Frame.GestureRecognizers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" 
                                       Text="📦 Отсканированные коробки" 
                                       TextColor="White" 
                                       FontSize="16" 
                                       FontAttributes="Bold" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="{Binding ScannedCount, StringFormat='{0} шт.'}" 
                                           TextColor="White" 
                                           FontSize="14" />
                                    <Label Text="{Binding IsBoxListExpanded, Converter={StaticResource ExpandIconConverter}}" 
                                           TextColor="White" 
                                           FontSize="16" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>

                        <!-- Список - отображается только если развернут -->
                        <CollectionView Grid.Row="1"
                                        IsVisible="{Binding IsBoxListExpanded}"
                                        ItemsSource="{Binding ScannedBoxes}"
                                        HeightRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4" Margin="8,0" ColumnDefinitions="Auto, *, Auto">
                                        <Label Grid.Column="0" 
                                               Text="📦" 
                                               FontSize="16"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Padding="8,0">
                                            <Label Text="{Binding BoxNumber, StringFormat='Коробка #{0}'}" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding ProductName}" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding CurrentQuantity, StringFormat='{0} шт.'}" 
                                                       FontSize="11" 
                                                       TextColor="Gray" />
                                                <Label Text="{Binding Grade}" 
                                                       FontSize="11" 
                                                       TextColor="Gray" />
                                                <Label Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" 
                                                       FontSize="11" 
                                                       TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <!-- Крестик для удаления -->
                                        <Button Grid.Column="2"
                                                Text="✕"
                                                Command="{Binding BindingContext.RemoveBoxCommand, Source={RelativeSource AncestorType={x:Type views:ShippingPage}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="Red"
                                                FontSize="18"
                                                Padding="8,0" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Frame>

                <!-- ============================================================ -->
                <!-- Индикатор работы приложения -->
                <!-- ============================================================ -->

                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   Color="{StaticResource PrimaryColor}" 
                                   HorizontalOptions="Center" />

                <!-- Индикатор офлайн-режима -->
                <Label Text="📴 Офлайн-режим" 
                       FontSize="11" 
                       TextColor="Orange"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsOnline, Converter={StaticResource InverseBooleanConverter}}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
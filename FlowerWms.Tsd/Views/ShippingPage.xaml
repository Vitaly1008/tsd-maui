<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:local="clr-namespace:FlowerWms.Tsd.Views"
                x:Class="FlowerWms.Tsd.Views.ShippingPage"
                Title="Отгрузка">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Верхняя панель -->
        <VerticalStackLayout Grid.Row="0" Padding="10">
            <Label Text="📦 Отгрузка товара" FontSize="24" FontAttributes="Bold" 
                   HorizontalOptions="Center"/>
            
            <!-- Статус сканирования -->
            <Frame BackgroundColor="{Binding ScanStatusColor}" 
                   CornerRadius="8" Margin="0,5">
                <HorizontalStackLayout Spacing="10" Padding="10">
                    <Label Text="{Binding ScanStatusIcon}" FontSize="24"/>
                    <Label Text="{Binding ScanStatusText}" FontSize="16" TextColor="White"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Информация о коробке -->
            <Frame IsVisible="{Binding IsBoxScanned}" BackgroundColor="#F5F5F5">
                <VerticalStackLayout>
                    <Label Text="{Binding BoxInfoText}" FontSize="14"/>
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="№" FontAttributes="Bold"/>
                        <Label Text="{Binding BoxNumberDisplay}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>

        <!-- Список коробок -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <!-- Заголовок списка -->
                <Frame Margin="10" BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Text="📦 Список коробок" 
                                Command="{Binding ToggleBoxListCommand}"
                                BackgroundColor="Transparent" TextColor="Black"
                                HorizontalOptions="Start"/>
                        
                        <Label Grid.Column="1" Text="{Binding ScannedCount}" 
                               FontSize="18" FontAttributes="Bold"/>
                    </Grid>
                </Frame>

                <!-- Список коробок -->
                <CollectionView IsVisible="{Binding IsBoxListExpanded}"
                                ItemsSource="{Binding ScannedBoxes}"
                                Margin="10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#E0E0E0" CornerRadius="5" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <VerticalStackLayout Grid.Column="0" Grid.RowSpan="2">
                                        <Label Text="№{Binding BoxNumber}" 
                                               FontAttributes="Bold" FontSize="16"/>
                                        <Label Text="{Binding ProductName}" 
                                               FontSize="14" TextColor="Gray"/>
                                        <HorizontalStackLayout>
                                            <Label Text="{Binding CurrentQuantity}" 
                                                   FontSize="14" TextColor="Blue"/>
                                            <Label Text=" шт." FontSize="14" TextColor="Gray"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2"
                                                          Spacing="5">
                                        <Button Text="📋" Command="{Binding Path=BindingContext.ShowBoxHistoryCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="Gray"/>
                                        <Button Text="✕" Command="{Binding Path=BindingContext.RemoveBoxCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="Red"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Нижняя панель управления -->
        <VerticalStackLayout Grid.Row="2" Padding="10" Spacing="10">
            <!-- Переключатель режима отгрузки -->
            <Button Text="{Binding ShipModeText}"
                    Command="{Binding ToggleShipModeCommand}"
                    IsVisible="{Binding CanPartialShip}"
                    BackgroundColor="{Binding ShipModeColor}"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="10"/>

            <!-- Управление количеством (для частичной отгрузки) -->
            <Frame IsVisible="{Binding IsPartialShipmentMode}">
                <VerticalStackLayout>
                    <Label Text="Количество для отгрузки:" FontSize="14"/>
                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                        <Button Text="−" Command="{Binding DecreaseQuantityCommand}"
                                BackgroundColor="#FF5722" TextColor="White"
                                WidthRequest="50" HeightRequest="50" FontSize="24"
                                CornerRadius="25"/>
                        
                        <Label Text="{Binding ShipQuantityDisplay}" 
                               FontSize="32" FontAttributes="Bold"
                               HorizontalOptions="Center" WidthRequest="80"
                               HorizontalTextAlignment="Center"/>
                        
                        <Button Text="+" Command="{Binding IncreaseQuantityCommand}"
                                BackgroundColor="#4CAF50" TextColor="White"
                                WidthRequest="50" HeightRequest="50" FontSize="24"
                                CornerRadius="25"/>
                    </HorizontalStackLayout>
                    <Label Text="Макс: {Binding MaxQuantity} шт." FontSize="12" 
                           TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Кнопки действий -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="❌ Отмена" 
                        Command="{Binding CancelOperationCommand}"
                        BackgroundColor="#FF5722" TextColor="White"
                        FontSize="16" CornerRadius="10"/>
                
                <Button Grid.Column="1" Text="✅ Отгрузить" 
                        Command="{Binding ConfirmOperationCommand}"
                        BackgroundColor="#4CAF50" TextColor="White"
                        FontSize="16" CornerRadius="10">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ScannedBoxes.Count}"
                                     Value="0">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Индикатор загрузки -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="#2196F3"/>
        </VerticalStackLayout>
    </Grid>
</local:BasePage>
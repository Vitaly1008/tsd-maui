<?xml version="1.0" encoding="utf-8" ?>
<!-- Страница "О программе" -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                x:Class="FlowerWms.Tsd.Views.AboutPage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:AboutViewModel"
                Title="">

    <ScrollView>
        <StackLayout Padding="24,24,24,12" VerticalOptions="Center">
            <!-- Иконка приложения -->
            <Frame WidthRequest="80" 
                   HeightRequest="80" 
                   CornerRadius="40" 
                   BackgroundColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Center">
                <Label Text="{Binding AppIcon}" 
                       FontSize="40" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Frame>
            
            <!-- Название приложения -->
            <Label Text="{Binding AppName}" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,16,0,0" />
            
            <!-- Версия -->
            <Label Text="{Binding AppVersion}" 
                   FontSize="18" 
                   TextColor="Gray" 
                   HorizontalTextAlignment="Center" />
            
            <!-- Режим работы -->
            <Label Text="{Binding AppMode}" 
                   FontSize="16" 
                   TextColor="Blue" 
                   HorizontalTextAlignment="Center" />
            
            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16,0,16" />
            
            <!-- Дата сборки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                
                <Label Grid.Column="0" Text="📅 Дата сборки" TextColor="Gray" />
                <Label Grid.Column="1" Text="{Binding BuildDate}" 
                       HorizontalTextAlignment="End" 
                       FontSize="13" />
            </Grid>
            
            <BoxView HeightRequest="1" Color="LightGray" Margin="0,0,0,16" />
            
            <!-- Копирайт -->
            <Label Text="{Binding Copyright}" 
                   FontSize="14" 
                   TextColor="Gray" 
                   HorizontalTextAlignment="Center" />
            
            <Label Text="{Binding CopyrightDetail}" 
                   FontSize="12" 
                   TextColor="Gray" 
                   HorizontalTextAlignment="Center" />
        </StackLayout>
    </ScrollView>
</views:BasePage>
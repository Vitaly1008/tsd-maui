<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                x:Class="FlowerWms.Tsd.Views.HomePage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:HomeViewModel"
                Title="">
    
    <views:HomePage.BindingContext>
        <viewmodel:HomeViewModel />
    </views:HomePage.BindingContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <!-- Верхняя панель - добавить индикатор синхронизации -->
    <Grid Grid.Row="0" 
        Padding="16,12"
        BackgroundColor="{StaticResource PrimaryColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <VerticalStackLayout Grid.Column="0" Spacing="2">
            <Label Text="ALPHA WMS" 
                TextColor="White" 
                FontSize="18"
                FontAttributes="Bold" />
            <Label Text="{Binding ServerAddress, StringFormat='🌐 {0}'}" 
                TextColor="White" 
                FontSize="10"
                Opacity="0.7" />
        </VerticalStackLayout>

        <!-- Бейдж с количеством ожидающих синхронизации -->
        <Frame Grid.Column="1"
            IsVisible="{Binding PendingCount, Converter={StaticResource GreaterThanZeroConverter}}"
            BackgroundColor="{StaticResource WarningColor}"
            CornerRadius="12"
            Padding="8,2"
            Margin="0,0,8,0">
            <HorizontalStackLayout Spacing="4">
                <Label Text="🔄" TextColor="White" FontSize="12" />
                <Label Text="{Binding PendingCount}" 
                    TextColor="White" 
                    FontSize="11"
                    FontAttributes="Bold" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Иконка статуса подключения -->
        <Label Grid.Column="2" 
            Text="{Binding ConnectionStatusIcon}" 
            FontSize="18" />
    </Grid>

        <!-- Основной контент -->
        <ScrollView Grid.Row="1" Padding="12">
            <VerticalStackLayout Spacing="12">
                <!-- Приемка -->
                <Frame CornerRadius="10"
                       Padding="0" 
                       HasShadow="True"
                       BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToReceivingCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                          Padding="12"
                          HeightRequest="60">
                        <Label Grid.Column="0" 
                               Text="📥" 
                               FontSize="24"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label Text="Приемка" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Прием товара" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Отгрузка -->
                <Frame CornerRadius="10"
                       Padding="0" 
                       HasShadow="True"
                       BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToShippingCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                          Padding="12"
                          HeightRequest="60">
                        <Label Grid.Column="0" 
                               Text="📤" 
                               FontSize="24"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label Text="Отгрузка" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Отгрузка товара" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Инвентаризация -->
                <Frame CornerRadius="10"
                       Padding="0" 
                       HasShadow="True"
                       BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToInventoryCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                          Padding="12"
                          HeightRequest="60">
                        <Label Grid.Column="0" 
                               Text="📊" 
                               FontSize="24"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label Text="Инвентаризация" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Пересчет остатков" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Кнопка синхронизации -->
                <Frame CornerRadius="10"
                    Padding="0" 
                    HasShadow="True"
                    BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SyncCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                        Padding="12"
                        HeightRequest="60">
                        <Label Grid.Column="0" 
                            Text="{Binding IsSyncing, Converter={StaticResource SyncStatusIconConverter}}" 
                            FontSize="24"
                            HorizontalOptions="Center" 
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label FontSize="16" FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                Binding="{Binding IsSyncing}"
                                                Value="True">
                                        <Setter Property="Text" Value="⏳ Синхронизация..." />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                Binding="{Binding IsSyncing}"
                                                Value="False">
                                        <Setter Property="Text" Value="🔄 Синхронизация" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding SyncStatusMessage}" 
                                FontSize="12" 
                                TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Нижняя панель с кнопками "Поиск" и "Выход" -->
                <Grid Grid.Row="2" 
                    Padding="12,8"
                    BackgroundColor="White"
                    ColumnDefinitions="*, *"
                    ColumnSpacing="8">
                    
                    <!-- Кнопка "Поиск сервера" -->
                    <Button Grid.Column="0"
                            x:Name="FindServerButton"
                            Command="{Binding FindServerCommand}"
                            IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBooleanConverter}}"
                            BackgroundColor="White"
                            TextColor="{StaticResource PrimaryColor}"
                            BorderColor="{StaticResource PrimaryColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="12"
                            FontAttributes="Bold">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                        Binding="{Binding IsSearching}"
                                        Value="True">
                                <Setter Property="Text" Value="⏳ Поиск..." />
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                        Binding="{Binding IsSearching}"
                                        Value="False">
                                <Setter Property="Text" Value="🔍 Поиск сервера" />
                                <Setter Property="IsEnabled" Value="True" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Кнопка "Выход" -->
                    <Button Grid.Column="1"
                            Text="🚪 Выход"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource DangerColor}"
                            BorderColor="{StaticResource DangerColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="12"
                            FontAttributes="Bold" />
                </Grid>


            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
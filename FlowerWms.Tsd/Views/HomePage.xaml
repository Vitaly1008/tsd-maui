<?xml version="1.0" encoding="utf-8" ?>
<!-- Главная страница -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:FlowerWms.Tsd.Views"
                xmlns:viewmodel="clr-namespace:FlowerWms.Tsd.ViewModels"
                x:Class="FlowerWms.Tsd.Views.HomePage"
                NavigationPage.HasNavigationBar="False"
                x:DataType="viewmodel:HomeViewModel"
                Title="">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0"
              Padding="16,12"
              BackgroundColor="{StaticResource PrimaryColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <!-- ✅ ИСПРАВЛЕНО: версия в верхней панели + тап на About -->
                <Label Text="{Binding Version, StringFormat='ALPHA WMS {0}'}"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAboutCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding ServerAddress, StringFormat='🌐 {0}'}"
                    TextColor="White"
                    FontSize="10"
                    Opacity="0.7" />
            </VerticalStackLayout>

            <Frame Grid.Column="1"
                   IsVisible="{Binding PendingCount, Converter={StaticResource GreaterThanZeroConverter}}"
                   BackgroundColor="{StaticResource WarningColor}"
                   CornerRadius="12"
                   Padding="8,2"
                   Margin="0,0,8,0">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="🔄" TextColor="White" FontSize="12" />
                    <Label Text="{Binding PendingCount}"
                           TextColor="White"
                           FontSize="11"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Frame>

            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding ConnectionStatusIcon}"
                       FontSize="18"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ✅ ДОБАВЛЕНО: строка статуса (текст подключения + статус синхронизации) -->
        <Grid Grid.Row="1"
              Padding="16,6"
              BackgroundColor="#EEEEEE"
              ColumnDefinitions="Auto, *">
            <Label Grid.Column="0"
                   Text="{Binding ConnectionStatus}"
                   FontSize="11"
                   TextColor="{StaticResource PrimaryColor}"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding SyncStatusMessage}"
                   FontSize="11"
                   TextColor="Gray"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Основной контент -->
        <ScrollView Grid.Row="2" Padding="12">
            <VerticalStackLayout Spacing="12">
                <!-- Приемка -->
                <Frame CornerRadius="10"
                       Padding="0"
                       HasShadow="True"
                       BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToReceivingCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                          Padding="12"
                          HeightRequest="60">
                        <Label Grid.Column="0"
                               Text="📥"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label Text="Приемка" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Прием товара" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Отгрузка -->
                <Frame CornerRadius="10"
                       Padding="0"
                       HasShadow="True"
                       BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToShippingCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                          Padding="12"
                          HeightRequest="60">
                        <Label Grid.Column="0"
                               Text="📤"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label Text="Отгрузка" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Отгрузка товара" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Инвентаризация -->
                <Frame CornerRadius="10"
                       Padding="0"
                       HasShadow="True"
                       BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToInventoryCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                          Padding="12"
                          HeightRequest="60">
                        <Label Grid.Column="0"
                               Text="📊"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <Label Text="Инвентаризация" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Пересчет остатков" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Очередь синхронизации -->
                <Frame CornerRadius="10"
                    Padding="0"
                    HasShadow="True"
                    BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToPendingCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="44, *, 32"
                        Padding="12"
                        HeightRequest="60">
                        <Label Grid.Column="0"
                            Text="📋"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Padding="6,0,0,0" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Очередь синхронизации" FontSize="16" FontAttributes="Bold" />
                                <Frame IsVisible="{Binding PendingCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                    BackgroundColor="{StaticResource WarningColor}"
                                    CornerRadius="12"
                                    Padding="6,1">
                                    <Label Text="{Binding PendingCount}"
                                        TextColor="White"
                                        FontSize="11"
                                        FontAttributes="Bold" />
                                </Frame>
                            </HorizontalStackLayout>
                            <Label Text="Управление операциями" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Нижняя панель с кнопками -->
                <Grid Padding="0,8,0,0"
                    BackgroundColor="White"
                    ColumnDefinitions="*, *, *"
                    ColumnSpacing="8">

                    <!-- Кнопка "Синхронизация" -->
                    <Button Grid.Column="0"
                            Text="🔄 Синхр."
                            Command="{Binding SyncCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertBooleanConverter}}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="10"
                            FontAttributes="Bold" />

                    <!-- ✅ Кнопка "Поиск" — убран DataTrigger, используется SearchButtonTextConverter -->
                    <Button Grid.Column="1"
                            Text="{Binding IsSearching, Converter={StaticResource SearchButtonTextConverter}}"
                            Command="{Binding FindServerCommand}"
                            IsEnabled="{Binding IsSearching, Converter={StaticResource InvertBooleanConverter}}"
                            BackgroundColor="White"
                            TextColor="{StaticResource PrimaryColor}"
                            BorderColor="{StaticResource PrimaryColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="10"
                            FontAttributes="Bold" />

                    <!-- Кнопка "Выход" -->
                    <Button Grid.Column="2"
                            Text="🚪 Выход"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource DangerColor}"
                            BorderColor="{StaticResource DangerColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="10"
                            FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <!-- ✅ ОВЕРЛЕЙ СИНХРОНИЗАЦИИ -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
            IsVisible="{Binding IsSyncing}"
            BackgroundColor="#B0000000"
            InputTransparent="False"
            ZIndex="9999">
            <VerticalStackLayout Spacing="14"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                <ActivityIndicator IsRunning="True"
                                Color="White"
                                HeightRequest="48"
                                WidthRequest="48" />
                <Label Text="{Binding SyncStatusMessage}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        <!-- ✅ ОВЕРЛЕЙ ПОИСКА СЕРВЕРА -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
            IsVisible="{Binding IsSearching}"
            BackgroundColor="#B0000000"
            InputTransparent="False"
            ZIndex="9999">
            <VerticalStackLayout Spacing="14"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                <ActivityIndicator IsRunning="True"
                                Color="White"
                                HeightRequest="48"
                                WidthRequest="48" />
                <Label Text="🔍 Поиск сервера..."
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />
                <Label Text="{Binding SearchProgressText}"
                    TextColor="White"
                    FontSize="12"
                    Opacity="0.7"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</views:BasePage>